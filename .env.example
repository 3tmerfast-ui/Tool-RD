# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# Khoá Gemini API (lấy tại https://aistudio.google.com/apikey)
# Có thể nhập nhiều key, phân tách bằng dấu phẩy để cân tải / né quota.
# GEMINI_API_KEY không còn dùng (đã thay bằng Flow extension + OpenRouter)
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter — phân tích ảnh (vision -> JSON). CẢNH BÁO: VITE_ => lộ ra frontend.
VITE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
# (tuỳ chọn) ép extension ID nếu beacon không tự phát hiện được:
# VITE_FLOW_EXTENSION_ID=

# Book BE queue — tạo ảnh on-prem qua app.3tify.com.
# Cả hai phải có giá trị thì mới dùng BE queue; để trống = dùng Chrome extension.
# VITE_BOOK_BE_URL=https://app.3tify.com
# VITE_BOOK_AUTH_TOKEN=<10-year Supabase JWT>

# MuseAI Bridge on-prem (máy Windows 3090 qua Tailscale) — tạo ảnh + video, chạy SONG SONG.
# Engine mặc định: flow | mindesk | muse (có thể đổi nhanh trên Header, lưu theo từng máy).
# VITE_IMAGE_PROVIDER=muse
# Target của proxy /muse trong vite dev server (app phải chạy trên máy nằm trong Tailnet):
# MUSE_API_URL=http://100.126.145.3:8770
# Base URL frontend gọi tới; dev để mặc định /muse. Bản Vercel dùng Tailscale Funnel:
# VITE_MUSE_BASE_URL=https://desktop-bpavqpt.tail476398.ts.net:8443
# API key của bridge (MUSE_API_KEY trong ../MuseAI/.env) — bắt buộc khi đi qua Funnel:
# VITE_MUSE_API_KEY=
# Số ảnh/video chạy song song trên bridge (1–5, mặc định 3):
# VITE_MUSE_CONCURRENCY=3

# Supabase (lấy tại Dashboard → Project Settings → Database / API)
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
